NODE_ENV=production
PORT=3000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_NAME=مدير النظام
ADMIN_PHONE=+967700000000
ADMIN_EMAIL=replace@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
DB_PATH=./data/khadamat.db
UPLOAD_DIR=./data/uploads
ROUTING_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_MS=8000
COOKIE_SECURE=true
TRUST_PROXY=true
CORS_ORIGINS=
LOG_LEVEL=info

# AI for 'اطلب لي': automatic when configured; local rules always remain the fallback.
# Either set AI_INTENT_URL + AI_INTENT_KEY for an OpenAI-compatible provider, or set OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_INTENT_URL=
AI_INTENT_KEY=
AI_INTENT_MODEL=
AI_INTENT_AUTO=true
AI_INTENT_TIMEOUT_MS=1800
AI_INTENT_CIRCUIT_COOLDOWN_MS=30000

# Customer sign-in: WhatsApp OTP only. Requires a WhatsApp Business/Cloud API sender.
WHATSAPP_OTP_ENABLED=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_OTP_TEMPLATE=khadamat_otp
WHATSAPP_OTP_LANGUAGE=ar
