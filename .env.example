# ===== خدمات — متغيرات البيئة =====
NODE_ENV=development
PORT=3000
# مسار قاعدة البيانات (SQLite). في Railway يجب ربط Volume بهذا المسار حتى تبقى البيانات بعد إعادة النشر.
DB_PATH=./data/khadamat.db
UPLOAD_DIR=./data/uploads
# إلزامي في الإنتاج: 32 حرفًا على الأقل (openssl rand -hex 32)
JWT_SECRET=
ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30
# true عند التشغيل خلف HTTPS
COOKIE_SECURE=false
# عند التشغيل خلف Nginx/Load balancer
TRUST_PROXY=false
# أصول مسموحة لـ CORS مفصولة بفواصل (فارغ = نفس الأصل فقط)
CORS_ORIGINS=
# مزود الخرائط في الواجهة: leaflet-osm | manual
MAP_PROVIDER=leaflet-osm
# الافتراضيات التشغيلية (اليمن / YER / Asia/Aden / العربية) محفوظة في جدول system_settings وتُعدَّل من اللوحة
# فاصل معالج الإسناد/انتهاء المهلة بالمللي ثانية
ASSIGNMENT_TICK_MS=15000
LOG_LEVEL=info
# حساب المدير الأول. عند بدء السيرفر يتم تشغيل Seed تلقائيًا؛ إن تُركت كلمة المرور فارغة تُولَّد كلمة مرور وتُسجّل مرة واحدة في Logs
ADMIN_NAME=مدير النظام
ADMIN_PHONE=+967700000000
ADMIN_EMAIL=admin@khadamat.local
ADMIN_PASSWORD=
